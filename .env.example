# ==============================================================
# CẤU HÌNH API KEYS CHO HỆ THỐNG KIỂM TOÁN CHI TIÊU CÔNG TÁC (T2)
# ==============================================================
# Hướng dẫn: Sao chép file này thành .env và điền API key thực tế của bạn.
# Tuyệt đối không commit file .env chứa key thật lên GitHub!

# 1. Groq API Key (Khuyến nghị cho Agent loop & Judge vì tốc độ cao)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. OpenAI API Key (Tùy chọn: dùng cho GPT-4o-mini hoặc Text-Embedding-3-small)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# 3. Jina AI API Key (Tùy chọn: dùng cho Jina Embeddings v3 theo bài học Tuần 3)
JINA_API_KEY=jina_your_jina_api_key_here

# Cấu hình mô hình và tham số hệ thống
LLM_MODEL=openai/gpt-oss-20b
EVAL_MODEL=openai/gpt-oss-20b
MAX_AGENT_STEPS=12
SEARCH_MODE=hybrid
